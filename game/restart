#!/bin/sh

ulimit -c unlimited

cd /home/hinoserm/neon/game

PIDFILE=protomuck.pid
STORE=data/store
PARMFILE=data/parmfile.cfg

say() {
    echo "[`date '+%Y-%m-%d %H:%M:%S'`] $*"
}

getparm() {
    sed -n "s/^$1=[[:space:]]*//p" "$PARMFILE" 2>/dev/null | head -1 | tr -d '\r'
}

say "Restarting protomuck in `pwd`"

# Stop any running instance first. Anything unexpected here is non-fatal:
# fall through and start the server regardless.
if [ -r "$PIDFILE" ]; then
    pid=`cat "$PIDFILE" 2>/dev/null`

    case "$pid" in
        '' | *[!0-9]*)
            say "Pid file $PIDFILE is empty or not a number; nothing to stop."
            pid=
            ;;
    esac

    if [ -n "$pid" ]; then
        if kill -0 "$pid" 2>/dev/null; then
            case "`ps -p \"$pid\" -o comm= 2>/dev/null`" in
            protomuck)
                say "Found running protomuck (pid $pid). Sending TERM..."
                if kill "$pid" 2>/dev/null; then
                    i=0
                    while kill -0 "$pid" 2>/dev/null; do
                        i=`expr $i + 1`
                        if [ "$i" -ge 60 ]; then
                            say "Still alive after ${i}s; giving up on a clean stop."
                            break
                        fi
                        [ "`expr $i % 5`" -eq 0 ] && say "  waiting for pid $pid to exit (${i}s)..."
                        sleep 1
                    done
                    if kill -0 "$pid" 2>/dev/null; then
                        say "Warning: pid $pid did not exit. Starting anyway."
                    else
                        say "Stopped after ${i}s."
                    fi
                else
                    say "Could not signal pid $pid. Starting anyway."
                fi
                ;;
            '')
                say "Pid $pid vanished before it could be signalled."
                ;;
            *)
                say "Pid $pid is `ps -p \"$pid\" -o comm= 2>/dev/null`, not protomuck. Leaving it alone."
                ;;
            esac
        else
            say "Pid $pid from $PIDFILE is not running (stale pid file)."
        fi
    fi
fi

# The object store dumps in place with per-file atomic renames, so the
# old flat-file backup-and-promote dance is gone. Sanity-check the store
# exists before starting.
if [ ! -f "$STORE/manifest.json" ]; then
    say "FATAL: no object store at $STORE (manifest.json missing)."
    say "To import a flat database: ./protomuck -convert data/neon.db $STORE"
    exit 1
fi
objcount=`find "$STORE/objects" -name '*.json' 2>/dev/null | wc -l`
say "Object store: $STORE ($objcount objects)"

ports=
for p in mainport sslport wwwport puebloport; do
    v=`getparm "$p"`
    case "$v" in
        '' | 0) ;;
        *) ports="$ports $p=$v" ;;
    esac
done
[ -n "$ports" ] || ports=" (from parmfile defaults)"

say "Starting protomuck, listening on:$ports"

# An in-game @restart from an older binary execs this script with a
# portlist argument ("8898 8877"). Ports come from the parmfile now,
# so drop purely numeric arguments and keep real server options.
opts=
for a in $*; do
    case "$a" in
        *[!0-9]*) opts="$opts $a" ;;
        *) say "Ignoring legacy port argument $a (ports come from $PARMFILE)" ;;
    esac
done
[ -n "$opts" ] && say "Extra server options:$opts"
./protomuck $opts "$STORE" "$STORE" &
started=$!
say "Launched as pid $started. Log: logs/status"
